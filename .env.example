# ---------------------------------------------------------------------------
# NTECH Board : variables d'environnement. Copier en .env (local) ou les saisir
# dans Coolify (onglet Environment Variables). Voir docs/DEPLOIEMENT.md.
# ---------------------------------------------------------------------------

# Base de données : mot de passe fixé une fois pour toutes (openssl rand -hex 24).
# docker-compose transmet la connexion à l'application par PGHOST/PGUSER/PGPASSWORD.
POSTGRES_PASSWORD=change-moi

# Projets : {slug} est remplacé par l'identifiant du projet (etourisme, pfo…)
PROJECT_HOSTS={slug}-board.neiba-technologies.com
# Projet servi si l'hôte ne correspond à aucun modèle (instance dédiée) : laisser vide sinon
DEFAULT_PROJECT=

# Administrateurs de la plateforme (NTECH SARL) : admin de tous les projets
SUPERADMIN_EMAILS=tech@mstudio.vc

# Envoi des e-mails (relais SMTP Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@neiba-technologies.com
SMTP_PASSWORD=
SMTP_FROM=NTECH Board <contact@neiba-technologies.com>

# Sessions et liens de connexion
SESSION_DAYS=30
LOGIN_TOKEN_MINUTES=20
COOKIE_SECURE=auto
