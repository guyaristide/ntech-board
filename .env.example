# ---------------------------------------------------------------------------
# NTECH Board : variables d'environnement. Copier en .env (local) ou les saisir
# dans Coolify (onglet Environment Variables). Voir docs/DEPLOIEMENT.md.
# ---------------------------------------------------------------------------

# Base de données : mot de passe fixé une fois pour toutes (openssl rand -hex 24).
# docker-compose transmet la connexion à l'application par PGHOST/PGUSER/PGPASSWORD.
POSTGRES_PASSWORD=change-moi

# Projets : {slug} est remplacé par l'identifiant du projet (etourisme, pfo…)
PROJECT_HOSTS={slug}-board.neiba-technologies.com
# Projet servi si l'hôte ne correspond à aucun modèle (instance dédiée) : laisser vide sinon
DEFAULT_PROJECT=

# Administrateurs de la plateforme (NTECH SARL) : admin de tous les projets
SUPERADMIN_EMAILS=k.neiba@neiba-technologies.com

# Envoi des e-mails (relais SMTP Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@neiba-technologies.com
SMTP_PASSWORD=
SMTP_FROM=NTECH Board <contact@neiba-technologies.com>

# Sessions et liens de connexion
SESSION_DAYS=30
LOGIN_TOKEN_MINUTES=20
COOKIE_SECURE=auto

# Chiffrement des clés de stockage (Cloudinary, MinIO, S3) enregistrées en base.
# Chaîne longue et aléatoire : openssl rand -base64 32. Sans elle, seul le stockage local est utilisable.
# Ne plus la changer ensuite : les clés déjà enregistrées deviendraient illisibles.
SECRETS_KEY=

# Analyse des échanges (Slack, réunions, transcriptions) par Claude : propositions à relire.
# La clé Claude est propre à chaque projet (Réglages du projet, chiffrée avec SECRETS_KEY).
# Facultatifs : modèle et effort (low, medium, high, xhigh, max), communs à la plateforme.
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Notifications par e-mail.
# Adresse publique d'un projet dans les liens des e-mails ({slug} = le projet). Vide : premier modèle
# de PROJECT_HOSTS, en https. En local : http://localhost:3000
PUBLIC_ORIGIN=
# Minutes de calme avant d'envoyer un e-mail « tout de suite » (absorbe les changements en rafale).
NOTIFY_QUIET_MINUTES=5
# Heure (du serveur) du récapitulatif quotidien et des rappels d'échéance.
NOTIFY_DIGEST_HOUR=8

# Notifications système (téléphone, ordinateur), même tableau fermé. Pas à pas : docs/DEPLOIEMENT.md,
# « Notifications système (clés VAPID) ». En bref, créez la paire de clés une seule fois :
#   npx web-push generate-vapid-keys
# puis recopiez « Public Key » dans VAPID_PUBLIC_KEY et « Private Key » dans VAPID_PRIVATE_KEY (secret).
# La même paire sert à tous les projets. Ne plus la changer ensuite : les abonnements des appareils
# deviendraient invalides et chacun devrait réactiver ses notifications. Vides : pas de notifications
# système, le reste fonctionne.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@neiba-technologies.com

# Console de la plateforme (super-administrateurs) : hôte sans projet, où l'on voit et administre tous
# les projets. Seules les adresses de SUPERADMIN_EMAILS, et celles qu'elles désignent dans la console,
# peuvent s'y connecter. En local : http://boards.localhost:3000
PLATFORM_HOST=boards.neiba-technologies.com
