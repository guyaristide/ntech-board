{
  "name": "cadrage-etourisme",
  "private": true,
  "version": "0.1.0",
  "description": "Espace de cadrage eTourisme : backlog des user stories et programme des ateliers",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "import:planning": "python3 scripts/import_planning.py",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 110,
    "arrowParens": "avoid"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.4"
  }
}
